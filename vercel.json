{
  "version": 2,
  "installCommand": "cd prototype && pnpm install --no-frozen-lockfile",
  "buildCommand": "cd prototype && pnpm build",
  "outputDirectory": "prototype/dist",
  "functions": {
    "api/**/*.js": { "maxDuration": 10 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
