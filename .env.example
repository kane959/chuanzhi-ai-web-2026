# CampusFlow runtime defaults. Keep real provider keys in a local .env file only.
MODEL_PROVIDER=demo
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
RAG_DATA_PATH=./data/campus-pack.json
APPROVAL_MODE=preview
# Comma-separated hostnames allowed for one-page source sync, e.g. example.edu.cn
SYNC_ALLOWED_HOSTS=
# Optional server-only token for protecting the sync endpoint. Never expose it in Vite variables.
SYNC_API_TOKEN=
PORT=8787
