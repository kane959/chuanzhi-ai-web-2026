# CampusFlow runtime defaults. Keep real provider keys in a local .env file only.
MODEL_PROVIDER=demo
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
RAG_DATA_PATH=./data/campus-pack.json
APPROVAL_MODE=preview
# Comma-separated hostnames allowed for one-page source sync, e.g. example.edu.cn
SYNC_ALLOWED_HOSTS=
# Optional server-only token for protecting the sync endpoint. Never expose it in Vite variables.
SYNC_API_TOKEN=
PORT=8787
# Public API origin used by the GitHub Pages build, e.g. https://campusflow-api.vercel.app
VITE_API_BASE_URL=
# CORS origin allowed to call the deployed API, e.g. https://kane959.github.io
PUBLIC_WEB_ORIGIN=https://kane959.github.io
